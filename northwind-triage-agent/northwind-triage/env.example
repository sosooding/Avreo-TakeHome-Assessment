# ─────────────────────────────────────────────────────────────
# Northwind Triage Agent — Environment Variables
# Copy this file to ".env" and fill in your key.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Your Google Gemini API key.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Optional settings (sensible defaults shown) ──────────────

# The Gemini model to use.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Seconds to wait between calls during batch evaluation, to stay
# under the free-tier per-minute request limit. Lower it if you
# are on a paid tier with higher limits.
# GEMINI_REQUEST_DELAY_S=4.5

# Port the backend server listens on.
# PORT=8001
