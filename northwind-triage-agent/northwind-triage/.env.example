# Northwind Triage Agent — Environment Variables
# Copy this file to .env and fill in your key

# ─── REQUIRED ─────────────────────────────────────────────
# Google Gemini API Key. Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# ─── OPTIONAL ─────────────────────────────────────────────
# Model. Defaults to gemini-3.1-flash-lite (15 RPM / 1000 RPD free tier).
# GEMINI_MODEL=gemini-3.1-flash-lite

# Seconds to wait between calls during batch evaluation.
# gemini-3.1-flash-lite is 15 RPM, so 4.5s is comfortable.
# For paid Tier 1 (150+ RPM), use 0.5 or lower.
# GEMINI_REQUEST_DELAY_S=4.5

# Server port (default 8001)
# PORT=8001
